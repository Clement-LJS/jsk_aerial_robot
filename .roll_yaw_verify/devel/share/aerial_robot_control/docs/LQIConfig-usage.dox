\subsubsection usage Usage
\verbatim
<node name="aerial_robot_control" pkg="aerial_robot_control" type="aerial_robot_control">
  <param name="lqi_flag" type="bool" value="False" />
  <param name="roll_pitch_p" type="double" value="200.0" />
  <param name="roll_pitch_i" type="double" value="10.0" />
  <param name="roll_pitch_d" type="double" value="20.0" />
  <param name="yaw_p" type="double" value="1.0" />
  <param name="yaw_i" type="double" value="1.0" />
  <param name="yaw_d" type="double" value="10.0" />
  <param name="z_p" type="double" value="1.0" />
  <param name="z_i" type="double" value="1.0" />
  <param name="z_d" type="double" value="10.0" />
</node>
\endverbatim

