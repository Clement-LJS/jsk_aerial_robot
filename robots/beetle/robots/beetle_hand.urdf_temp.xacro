<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="beetle" >

  <xacro:include filename="$(find beetle)/urdf/beetle_hand.urdf.xacro" />
  <xacro:include filename="$(find beetle)/urdf/common.xacro" />

  <xacro:beetle_center_link child1="1" child2="2" child3="3" child4="4"/>
  <xacro:beetle_thrust_link self="1" rotor_direction="-1"/>
  <xacro:beetle_thrust_link self="2" rotor_direction="1"/>
  <xacro:beetle_thrust_link self="3" rotor_direction="-1"/>
  <xacro:beetle_thrust_link self="4" rotor_direction="1"/>

  ##### beetle hand link #####

  <link name="handbase">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.00001"/>
      <inertia
          ixx="0.00001" iyy="0.00001" izz="0.00001"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  ### plusx ###

  <link name="plusx_hand">
    <inertial>
      <origin xyz="0.19178 0.00000 0.025771"/>
      <mass value="0.3900000"/>
      <inertia
  	  ixx="0.000699" ixy="-0.000004" ixz="0.000769"
  	  iyy="0.005953" iyz="-0.000005"
  	  izz="0.00541"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
    	<mesh filename="package://beetle/urdf/mesh/beetle_hand_handmech_all.dae"/>
      </geometry>
    </visual>
    <!-- <collision> -->
    <!--   <origin xyz="0.01215 0 0.022" rpy="0 0 0"/> -->
    <!--   <geometry> -->
    <!-- 	<box size="0.283 0.071 0.118"/> -->
    <!--   </geometry> -->
    <!-- </collision> -->
  </link>

  <link name="plusx_hand_palm">
    <inertial>
      <origin xyz="0.0 0.0 0.0"/>
      <mass value="0.00001"/>
      <inertia
  	  ixx="0.00001" ixy="0.00000" ixz="0.0000000"
  	  iyy="0.00001" iyz="0.00000"
  	  izz="0.00001"/>
    </inertial>
    <!-- <visual> -->
    <!--   <origin xyz="0 0 0" rpy="0.0 0 0"/> -->
    <!--   <geometry> -->
    <!--     <box size="0.01 0.01 0.01"/> -->
    <!--   </geometry> -->
    <!-- </visual> -->
  </link>

  ### minusx ###
  
  <link name="minusx_hand">
    <inertial>
      <origin xyz="-0.19178 0.000005 0.025771"/>
      <mass value="0.3900000"/>
      <inertia
  	  ixx="0.000699" ixy="-0.000004" ixz="0.000769"
  	  iyy="0.005953" iyz="-0.000005"
  	  izz="0.00541"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
    	<mesh filename="package://beetle/urdf/mesh/beetle_hand_handmech_all.dae"/>
      </geometry>
    </visual>
    <!-- <collision> -->
    <!--   <origin xyz="0.01215 0 0.022" rpy="0 0 0"/> -->
    <!--   <geometry> -->
    <!-- 	<box size="0.283 0.071 0.118"/> -->
    <!--   </geometry> -->
    <!-- </collision> -->
  </link>

  <link name="minusx_hand_palm">
    <inertial>
      <origin xyz="0.0 0.0 0.0"/>
      <mass value="0.00001"/>
      <inertia
  	  ixx="0.00001" ixy="0.00000" ixz="0.0000000"
  	  iyy="0.00001" iyz="0.00000"
  	  izz="0.00001"/>
    </inertial>
    <!-- <visual> -->
    <!--   <origin xyz="0 0 0" rpy="0.0 0 0"/> -->
    <!--   <geometry> -->
    <!--     <box size="0.01 0.01 0.01"/> -->
    <!--   </geometry> -->
    <!-- </visual> -->
  </link>
  
  ##### dummy grasp links #####

  ### plusx ###
  
  <link name="plusx_dummy_arm">
    <inertial>
      <mass value = "0.01" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.0001" ixy="0.0000" ixz="0.0000"
          iyy="0.0001" iyz="0.0000" izz="0.0001"/>
    </inertial>
  </link>

  <link name="plusx_dummy_palm">
    <inertial>
      <mass value = "0.001" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.0001" ixy="0.0000" ixz="0.0000"
          iyy="0.0001" iyz="0.0000" izz="0.0001"/>
    </inertial>
    <!-- <collision> -->
    <!--   <origin xyz="0 0 0" rpy="0 0 0"/> -->
    <!--   <geometry> -->
    <!--     <box size="0.01 0.01 0.01"/> -->
    <!--   </geometry> -->
    <!-- </collision> -->
  </link>

  <link name="dummy_gripper">
  <!-- <link name="plusx_dummy_gripper"> -->
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="0.01 0.01 0.01"/>
        </geometry>
    </collision>
    <visual>
        <origin xyz="0 0 0" rpy="0.0 0 0"/>
        <geometry>
            <box size="0.01 0.01 0.01"/>
        </geometry>
    </visual>
  </link>


  ### minusx ###

  <link name="minusx_dummy_arm">
    <inertial>
      <mass value = "0.01" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.0001" ixy="0.0000" ixz="0.0000"
          iyy="0.0001" iyz="0.0000" izz="0.0001"/>
    </inertial>
  </link>

  <link name="minusx_dummy_palm">
    <inertial>
      <mass value = "0.001" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.0001" ixy="0.0000" ixz="0.0000"
          iyy="0.0001" iyz="0.0000" izz="0.0001"/>
    </inertial>
    <!-- <collision> -->
    <!--   <origin xyz="0 0 0" rpy="0 0 0"/> -->
    <!--   <geometry> -->
    <!--     <box size="0.01 0.01 0.01"/> -->
    <!--   </geometry> -->
    <!-- </collision> -->
  </link>

  <link name="minusx_dummy_gripper">
    <inertial>
      <mass value = "0.001" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.0001" ixy="0.0000" ixz="0.0000"
          iyy="0.0001" iyz="0.0000" izz="0.0001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  ##### beetle hand joint #####

  <joint name="handbase_baselink_joint" type="fixed">
    <parent link="base_link"/>
    <child link="handbase"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  
  ### plusx ###

  <joint name="handbase_plusx_hand_joint" type="fixed">
    <parent link="handbase"/>
    <child link="plusx_hand"/>
    <origin xyz="0.031 0 0.107" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="plusx_hand_palm_joint" type="revolute"> <!-- revolute -->
    <parent link="plusx_hand"/>
    <child link="plusx_hand_palm"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
    <dynamics damping="0.2" friction="0.02"/>
    <origin xyz="0.246 0 0.045" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="plusx_base_dummy_arm_joint" type="fixed">
    <parent link="plusx_hand_palm"/>
    <child link="plusx_dummy_arm"/>
    <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="plusx_dummy_arm_palm_joint" type="revolute">
    <parent link="plusx_dummy_arm"/>
    <child link="plusx_dummy_palm"/>
    <origin xyz="0.00 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
    <dynamics damping="0.2" friction="0.02"/>
  </joint>

  <!-- <joint name="plusx_dummy_arm_palm_joint" type="fixed"> -->
  <!--   <parent link="plusx_dummy_arm"/> -->
  <!--   <child link="plusx_dummy_palm"/> -->
  <!--   <origin xyz="0.00 0 0" rpy="0 0 0"/> -->
  <!--   <axis xyz="1 0 0"/> -->
  <!-- </joint> -->

  <joint name="plusx_dummy_palm_gripper_joint" type="revolute">
    <parent link="plusx_dummy_palm"/>
    <child link="dummy_gripper"/>
    <!-- <child link="plusx_dummy_gripper"/> -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
    <dynamics damping="0.2" friction="0.02"/>
  </joint>

  ### minusx ###

  <joint name="handbase_minusx_hand_joint" type="fixed">
    <parent link="handbase"/>
    <child link="minusx_hand"/>
    <origin xyz="-0.031 0 0.107" rpy="0.000000 0.000000 3.141592"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="minusx_hand_palm_joint" type="revolute"> <!-- revolute -->
    <parent link="minusx_hand"/>
    <child link="minusx_hand_palm"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
    <dynamics damping="0.2" friction="0.02"/>
    <origin xyz="0.246 0 0.045" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
  </joint>

  <joint name="minusx_base_dummy_arm_joint" type="fixed">
    <parent link="minusx_hand_palm"/>
    <child link="minusx_dummy_arm"/>
    <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <!-- <joint name="minusx_dummy_arm_palm_joint" type="revolute"> -->
  <!--   <parent link="minusx_dummy_arm"/> -->
  <!--   <child link="minusx_dummy_palm"/> -->
  <!--   <origin xyz="0.00 0 0" rpy="0 0 0"/> -->
  <!--   <axis xyz="1 0 0"/> -->
  <!--   <limit lower="0" upper="0" effort="0" velocity="0"/> -->
  <!--   <dynamics damping="0.2" friction="0.02"/> -->
  <!-- </joint> -->

  <joint name="minusx_dummy_arm_palm_joint" type="fixed">
    <parent link="minusx_dummy_arm"/>
    <child link="minusx_dummy_palm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
  </joint>

  <joint name="minusx_dummy_palm_gripper_joint" type="revolute">
    <parent link="minusx_dummy_palm"/>
    <child link="minusx_dummy_gripper"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
    <dynamics damping="0.2" friction="0.02"/>
  </joint>

  ##### battery #####

  <joint name="battery1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery1"/>
    <origin xyz="0 0.044 0.055" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="battery1">
    <inertial>
      <origin xyz="0 0 -0.017" rpy="0 0 0"/>
      <mass value="0.41"/>
      <inertia
          ixx="0.00060259" ixy="0.0" ixz="0.0"
          iyy="0.00062827" iyz="0.0"
          izz="0.00010170"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.017"/>
      <geometry>
        <box size="0.13 0.044 0.034"/>
      </geometry>
    </visual>
  </link>

  <joint name="battery2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery2"/>
    <origin xyz="0 -0.044 0.055" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <link name="battery2">
    <inertial>
      <origin xyz="0 0 -0.017" rpy="0 0 0"/>
      <mass value="0.41"/>
      <inertia
          ixx="0.00060259" ixy="0.0" ixz="0.0"
          iyy="0.00062827" iyz="0.0"
          izz="0.00010170"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.017"/>
      <geometry>
        <box size="0.13 0.044 0.034"/>
      </geometry>
    </visual>
  </link>
  
</robot>
