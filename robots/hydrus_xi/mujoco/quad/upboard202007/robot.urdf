  <gazebo reference="thrust4">
    <dampingFactor>0.00</dampingFactor>
  </gazebo>
  

    #### dummy root link for KDL ####
    
  

    #### joints ####
    #### link joint ####
    
  

    #### gimbal joint ####
    
  <joint name="gimbal4" type="continuous">
    <limit effort="3.1" lower="-18.84955592153876" upper="18.84955592153876" velocity="20.0"/>
    <parent link="link4"/>
    <child link="gimbal_link4"/>
    <origin rpy="0 0 3.14159" xyz="0.3016 0 0.05967"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.8" friction="0.05"/>
  </joint>
  

    #### rotor parent link joint (virtual) ####
    
  <joint name="rotor_parent_link_joint4" type="fixed">
    <parent link="gimbal_link4"/>
    <child link="rotor_parent4"/>
    <origin rpy="0 0.34906585039 0" xyz="0 0 0.05091"/>
    <axis xyz="0 0 -1"/>
  </joint>
  

    #### rotor joint (virtual) ####
    
  <joint name="rotor4" type="continuous">
    <limit effort="100.0" lower="1" upper="35.5" velocity="0.5"/>
    <parent link="rotor_parent4"/>
    <child link="thrust4"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>
  

    #### battery ####
    
  <joint name="link42bat4" type="fixed">
    <parent link="link4"/>
    <child link="bat4"/>
    <origin rpy="0 0 1.5707963267948966" xyz="0.3133 0.0 -0.048"/>
  </joint>
  <link name="bat4">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.193"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00002"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="battery.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>
  


    #### hardware interface ####
    
  <gazebo reference="link4">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  

  #### flight controller ####
  
