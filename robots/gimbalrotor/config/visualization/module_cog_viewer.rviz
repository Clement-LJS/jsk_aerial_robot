Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Toolbars:
  toolButtonStyle: 2
Preferences:
  PromptSaveOnExit: false
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: gimbalrotor/base_link
    Frame Rate: 30
  Displays:
    - Class: rviz/MarkerArray
      Name: Module meshes frames and CoGs
      Enabled: true
      Marker Topic: cog_viewer_markers
      Queue Size: 2
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 30
  # The first tool is the default. Without tools, the Orbit controller does not
  # receive mouse input even though it renders a valid camera view.
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 0.7
      Focal Point: {X: -0.3, Y: 0, Z: -0.03}
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 850
