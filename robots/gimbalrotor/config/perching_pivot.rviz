Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: false
      Frames:
        All Enabled: true
      Tree: {}
    - Class: rviz/MarkerArray
      Name: Perching pivot and hand center
      Enabled: true
      Marker Topic: /gimbalrotor/perching/hand_center_markers
      Queue Size: 100
      Namespaces: {}
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Target Frame: <Fixed Frame>
      Distance: 2.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5
