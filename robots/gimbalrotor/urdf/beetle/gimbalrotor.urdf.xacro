<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="gimbalrotor_link" >
  <xacro:arg name="use_saw" default="true"/>
  <xacro:arg name="use_hand" default="true"/>
  
  <xacro:macro name="gimbalrotor_center_link" params="child1 child2 child3 child4">
    ## dummy
    <link name="root">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.000001" iyz="0.0"
            izz="0.000001"/>
      </inertial>
    </link>
    <joint name="root_joint" type="fixed">
      <parent link="root"/>
      <child link="base_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    ## link
    <link name="base_link">
      <inertial>
        <origin xyz="0.00193 0.00159 0.06156" rpy="0 0 0"/>  #################<!-- Changed -->
        <mass value="1.444000"/>  #################<!-- Changed -->
        <inertia
          ixx="0.0368599" ixy="-0.0000221" ixz="0.0002913"
	        iyy="0.0367152" iyz="-0.00007901"
	        izz="0.0663418"/>
      </inertial>  #################<!-- Changed -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://gimbalrotor/urdf/beetle/mesh/base_module_incenter.STL" scale="0.001 0.001 0.001"/>  #################<!-- Changed -->
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.0575" rpy="0 0 0"/>
        <geometry>
          <box size="0.518 0.518 0.241"/>
        </geometry>
      </collision>
    </link>

    <xacro:damping_factor link="base_link"/>

    <link name="fc">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.000001" iyz="0.0"
            izz="0.000001"/>
      </inertial>
    </link>
    <joint name="fc_joint" type="fixed">
      <child link="fc"/>
      <parent link="base_link"/>
      <origin rpy="0 0 0" xyz="0 0 0.06927"/>  #################<!-- Changed -->
      <axis xyz="0 0 1"/>
    </joint>

    ## rotor arm macro
    <xacro:macro name="dummy_rotor_arm" params="id x y z yaw">
      ## link
      <link name="rotor_arm${id}">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.0001"/>
          <inertia
              ixx="0.000001" ixy="0.0" ixz="0.0"
              iyy="0.0001" iyz="0.0"
              izz="0.0001"/>
        </inertial>
      </link>
      ## joint
      <joint name="base_arm_joint${id}" type="fixed">
        <parent link="base_link"/>
        <child link="rotor_arm${id}"/>
        <origin rpy="0 0 ${yaw}" xyz="${x} ${y} ${z}"/>
        <axis xyz="0 0 1"/>
      </joint>
    </xacro:macro>

    <xacro:dummy_rotor_arm id = "${child1}" x = "0.12216" y = "0.12215" z = "0.0555" yaw = "${pi/4.0}"/>
    <xacro:dummy_rotor_arm id = "${child2}" x = "-0.12216" y = "0.12215" z = "0.0555" yaw = "${pi*3.0/4.0}"/>
    <xacro:dummy_rotor_arm id = "${child3}" x = "-0.12216" y = "-0.12215" z = "0.0555" yaw = "${pi*5.0/4.0}"/>
    <xacro:dummy_rotor_arm id = "${child4}" x = "0.12216" y = "-0.12215" z = "0.0555" yaw = "${pi*7.0/4.0}"/>

    <xacro:friction self="base_link"/>
  </xacro:macro>

  <xacro:macro name="gimbalrotor_thrust_link" params="self rotor_direction">
    ## link
    #### rotor parent link (virtual) ####
    <link name="gimbal_link${self}">
      <inertial>
        <origin xyz="0.02375 0.00001 0.0078" rpy="0 0 0"/>  #################<!-- Changed -->
        <mass value="0.15890"/>  #################<!-- Changed -->
        <inertia
          ixx="0.0000742" ixy="-0.00000005" ixz="0.0000009"
          iyy="0.0000729" iyz="-0.00000002"
	        izz="0.0000774"/>
      </inertial>  #################<!-- Changed -->
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.033"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://gimbalrotor/urdf/beetle/mesh/gimbal_module.STL" scale="0.001 0.001 0.001"/>  #################<!-- Changed -->
        </geometry>
      </visual>
    </link>
    <xacro:damping_factor link="gimbal_link${self}"/>

    ## rotor parent link (virtual)
    <link name="rotor_parent${self}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.000001" iyz="0.0"
            izz="0.000001"/>
      </inertial>
    </link>

    ## thrust link (virtual)
    <link name="thrust${self}">
      <inertial>      
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.005"/>
        <inertia
            ixx="0.001" ixy="0.0" ixz="0.0"
            iyy="0.001" iyz="0.0"
            izz="0.001"/>
      </inertial>
    </link>
    <xacro:damping_factor link="thrust${self}"/>

    #### joints ####

    #### gimbal joints ####
    <joint name="gimbal${self}" type="revolute">
      <limit effort="6.6" lower="-1.57" upper="1.57" velocity="3.0"/>
      <parent link="rotor_arm${self}"/>
      <child link="gimbal_link${self}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="0.8" friction="0.0"/>
    </joint>

    <transmission name="joint_tran${self}">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="gimbal${self}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="servo${self}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    #### rotor parent link joint (virtual) ####
    <joint name="rotor_parent_link_joint${self}" type="fixed">
      <parent link="gimbal_link${self}"/>
      <child link="rotor_parent${self}"/>
      <origin rpy="0 0 0" xyz="0.018 0.00 0.00438"/>
      <axis xyz="0 0 ${rotor_direction}"/>
    </joint>

    #### rotor joint (virtual) ####
    <joint name="rotor${self}" type="continuous">
      <limit effort="100.0" lower="${min_force}" upper="${max_force}" velocity="0.5"/>
      <parent link="rotor_parent${self}"/>
      <child link="thrust${self}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 0 ${rotor_direction}"/>
    </joint>

    <transmission name="rotor_tran${self}">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="rotor${self}">
        <hardwareInterface>RotorInterface</hardwareInterface>
      </joint>
      <actuator name="rotor_actuator${self}">
        <hardwareInterface>RotorInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- ## link
  <link name="handbase">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.00001"/>
      <inertia
          ixx="0.00001" iyy="0.00001" izz="0.00001"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link> -->

  <xacro:if value="$(arg use_saw)">
    <!-- saw link  -->
    <link name="saw">
      <inertial>
	<origin xyz="0.31654 0.00003 0.03656"/>
	<mass value="0.423690"/>
	<inertia
	    ixx="0.0004659" ixy="-0.00014505" ixz="0.0002106"
	    iyy="0.0023921" iyz="-0.00000324"
	    izz="0.00222804"/>
      </inertial>
      <visual>
	<origin xyz="0 0 0" rpy="0 0 0"/>
	<geometry>
    	  <mesh filename="package://gimbalrotor/urdf/beetle/mesh/fullassem_pochitab.STL" scale="0.001 0.001 0.001"/>
	</geometry>
      </visual>
      <collision>
	<origin xyz="0.236 0.024 0.039" rpy="0 0 0"/>
	<geometry>
	  <box size="0.471 0.134 0.153"/>
	</geometry>
      </collision>
    </link>
  </xacro:if>

  <xacro:if value="$(arg use_hand)">
    <!-- pitch joint fix pipe link  -->  
    <link name="pitch_joint_link">
      <inertial>
        <origin xyz="0.16717 0.02381 0.00005"/>
        <mass value="0.19260"/>
        <inertia
        ixx="0.0001889" ixy="0.0000569" ixz="-0.0000002"
        iyy="0.0004543" iyz="0.0000003"
        izz="0.0006006"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://gimbalrotor/urdf/beetle/mesh/urdf_full_pitchjoint.STL" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.236 0.024 0" rpy="0 0 0"/>
        <geometry>
      <box size="0.253 0.09 0.038"/>
        </geometry>
      </collision>
    </link>

    ## passive hand link
    <link name="passive_hand_link">
      <inertial>
      <!-- <origin xyz="0.16829 0.00007 0.00007"/> <!-\- 26 or 27.5 -\-> -->
      <!-- <mass value="0.150"/> -->
      <!-- <inertia -->
      <!--     ixx="0.0000323" ixy="0.0000003" ixz="-0.0000014" -->
      <!--     iyy="0.0010134" iyz="0.000000006" -->
      <!--     izz="0.0010082"/> -->

      <origin xyz="0.20096 0.00005 0.00005"/> <!-- <!-\- 60 or 63 -\-> -->
      <mass value="0.210"/>
      <inertia
          ixx="0.0000946" ixy="-0.00000006" ixz="-0.0000018"
          iyy="0.0017155" iyz="0.000000007"
          izz="0.0016576"/>
          </inertial>
      <visual>
        <origin xyz="0.027 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://gimbalrotor/urdf/beetle/mesh/urdf_passive_hand.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0.236 0.024 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.253 0.09 0.038"/>
        </geometry>
      </collision>
    </link>

    <link name="perching_center">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.000001" iyz="0.0"
            izz="0.000001"/>
      </inertial>
    </link>
  </xacro:if>
  
  <!-- ## beetle hand joint
  <joint name="handbase_baselink_joint" type="fixed">
    <child link="handbase"/>
    <parent link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint> -->

  <xacro:if value="$(arg use_saw)">
    <joint name="saw_joint" type="fixed">
      <child link="saw"/>
      <parent link="base_link"/>
      <origin xyz="0.05918 0.00025 0.01700" rpy="0 0 0"/>
      <axis xyz="0 0 0"/>
    </joint>
  </xacro:if>

  <xacro:if value="$(arg use_hand)">
    <joint name="pipe_joint" type="fixed">
      <child link="pitch_joint_link"/>
      <parent link="base_link"/>
      <origin xyz="-0.05918 0.00025 0.01700" rpy="0 0 3.142"/>
      <axis xyz="0 0 0"/>
    </joint>

    <joint name="pitch_joint" type="revolute">
      <parent link="pitch_joint_link"/>
      <child link="passive_hand_link"/>
      <!-- location of the pitch axis -->
      <origin xyz="0.2205 0 0" rpy="0 0 0"/>  <!-- 0.02932 is pulley origin -->
      <axis xyz="0 1 0"/>
      <limit effort="10" velocity="0.1" lower="-1.57" upper="1.57"/>
      <dynamics damping="0.9" friction="0.05"/>
    </joint>

    <joint name="perching_center_joint" type="fixed">
      <parent link="passive_hand_link"/>
      <child link="perching_center"/>
      <origin xyz="0.056 0.00025 0" rpy="0 0 0"/>
    </joint>

    <transmission name="pitch_joint_transmission">
      <type>transmission_interface/SimpleTransmission</type>

      <joint name="pitch_joint">
        <hardwareInterface>
          hardware_interface/EffortJointInterface
        </hardwareInterface>
      </joint>

      <actuator name="pitch_joint_actuator">
        <hardwareInterface>
          hardware_interface/EffortJointInterface
        </hardwareInterface>

        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:if>
</robot>
