<launch>
  <arg name="instance" default="$(anon cog_viewer)"/>
  <arg name="preset" default="roll_yaw"/>
  <arg name="pose_source" default="preview"/>
  <arg name="model_source" default=""/>
  <arg name="robot_description_param" default="/gimbalrotor/robot_description"/>
  <arg name="tf_prefix" default="gimbalrotor"/>
  <arg name="reference_frame" default="gimbalrotor/base_link"/>
  <arg name="reference_file" default="$(find gimbalrotor)/config/visualization/beetle_mass_reference.yaml"/>
  <arg name="rviz" default="true"/>
  <!-- Process-local Mesa fallback also works when NVIDIA kernel/userspace drivers differ.
       LIBGL_ALWAYS_SOFTWARE alone does not select Mesa on a GLVND/NVIDIA desktop. -->
  <arg name="software_rendering" default="true"/>
  <arg name="rviz_fixed_frame" value="$(eval 'cog_viz_' + arg('instance') + '/world' if arg('pose_source') == 'preview' else arg('reference_frame'))"/>
  <node pkg="gimbalrotor" type="module_cog_viewer.py" name="viewer" ns="$(arg instance)" output="screen">
    <param name="preset" value="$(arg preset)"/>
    <param name="scene_id" value="$(arg instance)"/>
    <param name="pose_source" value="$(arg pose_source)"/>
    <param name="model_source" value="$(arg model_source)"/>
    <param name="robot_description_param" value="$(arg robot_description_param)"/>
    <param name="tf_prefix" value="$(arg tf_prefix)"/>
    <param name="reference_frame" value="$(arg reference_frame)"/>
    <param name="reference_file" value="$(arg reference_file)"/>
  </node>
  <!-- All preview markers are already in a unique fixed frame; no TF anchor. -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" ns="$(arg instance)"
        launch-prefix="$(eval 'env __GLX_VENDOR_LIBRARY_NAME=mesa LIBGL_ALWAYS_SOFTWARE=1' if arg('software_rendering') else '')"
        args="-d $(find gimbalrotor)/config/visualization/module_cog_viewer.rviz -f $(arg rviz_fixed_frame)">
    <remap from="cog_viewer_markers" to="viewer/markers"/>
  </node>
</launch>
