<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="gimbalrotor" >
  <xacro:arg name="robot_name" default="gimbalrotor" />
  <xacro:arg name="simulate_roll_yaw_contact" default="false" />

  <xacro:include filename="$(find gimbalrotor)/robots/beetle/gimbalrotor.urdf.xacro" />

  <!-- gazebo plugin for default controller and sensors -->
  <xacro:include filename="$(find aerial_robot_simulation)/xacro/spinal.gazebo.xacro" />
  <xacro:gazebo_spinal robot_name="$(arg robot_name)" mag_frame="fc" />

  <xacro:if value="$(arg simulate_roll_yaw_contact)">
    <gazebo>
      <plugin name="roll_yaw_passive_contact" filename="libroll_yaw_perching_gazebo.so">
        <robotNamespace>$(arg robot_name)</robotNamespace>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
