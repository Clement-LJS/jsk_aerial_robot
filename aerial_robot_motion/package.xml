<?xml version="1.0"?>
<package format="2">
  <name>aerial_robot_motion</name>
  <version>0.1.0</version>
  <description>Online constrained Cartesian whole-body reference generation for JSK aerial robots.</description>
  <maintainer email="chou@jsk.imi.i.u-tokyo.ac.jp">JSK Aerial Robot maintainers</maintainer>
  <license>BSD</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>aerial_robot_model</depend>
  <depend>aerial_robot_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>orocos_kdl</depend>
  <depend>kdl_parser</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <test_depend>rostest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>python3-rospkg</test_depend>
  <export>
    <aerial_robot_motion plugin="${prefix}/plugins/cost_plugins.xml"/>
    <aerial_robot_motion plugin="${prefix}/plugins/constraint_plugins.xml"/>
  </export>
</package>
